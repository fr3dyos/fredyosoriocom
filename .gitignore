yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp
*.temp

# ─── Environment / secrets (never commit) ──────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
credentials/

